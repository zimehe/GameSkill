<view class="admin-page page-shell">
  <view class="panel">
    <view class="eyebrow">隐藏管理页</view>
    <view class="title">内容维护后台</view>
    <view class="desc">用于新增、编辑、下线攻略内容。正式云端模式下会校验管理员 openid。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在校验权限...</view>
  <view wx:elif="{{!allowed}}" class="empty-state">当前账号没有管理权限。</view>

  <view wx:else class="menu-card" bindtap="openArticleList">
    <view class="menu-title">攻略管理</view>
    <view class="menu-desc">查看文章列表，新增或编辑攻略正文。</view>
  </view>
</view>
