.admin-page {
  background: #f5f2ea;
}

.panel,
.menu-card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #10161f;
  color: #fff8e9;
  box-shadow: 0 18rpx 44rpx rgba(16, 22, 31, 0.18);
}

.eyebrow {
  color: #f2c66d;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.desc,
.menu-desc {
  margin-top: 12rpx;
  color: rgba(255, 248, 233, 0.72);
  font-size: 26rpx;
  line-height: 1.55;
}

.menu-card {
  margin-top: 28rpx;
  background: #fff6dd;
  color: #18212c;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 900;
}

.menu-desc {
  color: #8a6b39;
}
