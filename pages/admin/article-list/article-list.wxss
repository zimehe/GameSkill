.admin-list {
  background: #f5f2ea;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #b07a22;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 8rpx;
  color: #18212c;
  font-size: 44rpx;
  font-weight: 900;
}

.create-button {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #10161f;
  color: #fff8e9;
  font-size: 26rpx;
}

.article-card {
  position: relative;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(31, 43, 58, 0.08);
}

.status {
  display: inline-block;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #fff6dd;
  color: #8a5f1d;
  font-size: 20rpx;
}

.article-title {
  margin-top: 12rpx;
  color: #18212c;
  font-size: 30rpx;
  font-weight: 900;
}

.article-meta {
  margin-top: 10rpx;
  color: #8a6b39;
  font-size: 22rpx;
}

.article-summary {
  margin-top: 12rpx;
  color: #66717f;
  font-size: 24rpx;
  line-height: 1.5;
}
