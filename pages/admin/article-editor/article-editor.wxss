.editor-page {
  background: #f5f2ea;
  padding-bottom: 80rpx;
}

.title {
  margin-bottom: 24rpx;
  color: #18212c;
  font-size: 44rpx;
  font-weight: 900;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #66717f;
  font-size: 24rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #18212c;
  font-size: 26rpx;
}

.textarea {
  min-height: 150rpx;
}

.content {
  min-height: 360rpx;
  font-family: monospace;
}

.publish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 30rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #18212c;
  font-size: 26rpx;
}

.save-button {
  border-radius: 999rpx;
  background: #10161f;
  color: #fff8e9;
  font-size: 30rpx;
  font-weight: 800;
}

.save-button::after {
  border: 0;
}
