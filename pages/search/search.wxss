.search-page {
  background:
    linear-gradient(180deg, #10161f 0%, #182536 280rpx, transparent 280rpx),
    #f5f2ea;
}

.search-head {
  color: #fff8e9;
}

.eyebrow {
  color: #f2c66d;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 18rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 18rpx 48rpx rgba(16, 22, 31, 0.18);
}

.search-input {
  flex: 1;
  color: #18212c;
  font-size: 28rpx;
}

.search-button {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #10161f;
  color: #fff8e9;
  font-size: 24rpx;
}

.result-list {
  margin-top: 34rpx;
}

.result-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(31, 43, 58, 0.08);
}

.result-game {
  color: #b07a22;
  font-size: 22rpx;
  font-weight: 800;
}

.result-title {
  margin-top: 10rpx;
  color: #18212c;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.result-summary {
  margin-top: 12rpx;
  color: #66717f;
  font-size: 24rpx;
  line-height: 1.5;
}

.tag-row {
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  margin: 0 10rpx 10rpx 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff6dd;
  color: #8a5f1d;
  font-size: 22rpx;
}
