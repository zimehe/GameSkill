.category-page {
  background:
    linear-gradient(180deg, rgba(16, 22, 31, 0.96) 0%, rgba(16, 22, 31, 0.96) 260rpx, transparent 260rpx),
    #f5f2ea;
}

.game-header {
  padding: 16rpx 4rpx 30rpx;
  color: #fff8e9;
}

.eyebrow {
  color: #f2c66d;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.game-title {
  margin-top: 18rpx;
  font-size: 54rpx;
  font-weight: 900;
}

.game-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 248, 233, 0.72);
  font-size: 26rpx;
  line-height: 1.5;
}

.tabs {
  width: 100%;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  width: 276rpx;
  min-height: 150rpx;
  margin-right: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  vertical-align: top;
}

.tab-active {
  border-color: rgba(242, 198, 109, 0.9);
  background: #fff6dd;
  box-shadow: 0 16rpx 36rpx rgba(176, 122, 34, 0.12);
}

.tab-name {
  color: #18212c;
  font-size: 30rpx;
  font-weight: 800;
}

.tab-desc {
  margin-top: 12rpx;
  color: #76808f;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: normal;
}

.module-section {
  margin-top: 8rpx;
}

.module-head {
  margin: 0 4rpx 20rpx;
}

.module-head-title {
  color: #18212c;
  font-size: 34rpx;
  font-weight: 900;
}

.module-head-note {
  margin-top: 8rpx;
  color: #76808f;
  font-size: 23rpx;
  line-height: 1.45;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.module-card {
  box-sizing: border-box;
  width: 334rpx;
  min-height: 250rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 86% 10%, rgba(242, 198, 109, 0.24), transparent 34%),
    rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 38rpx rgba(31, 43, 58, 0.08);
}

.module-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #10161f;
  color: #f2c66d;
  font-size: 30rpx;
  font-weight: 900;
}

.module-title {
  margin-top: 18rpx;
  color: #18212c;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.25;
}

.module-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #66717f;
  font-size: 22rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.module-cta {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff6dd;
  color: #8a5f1d;
  font-size: 22rpx;
  font-weight: 800;
}

.sort-row {
  display: flex;
  margin: 24rpx 0 6rpx;
}

.sort-pill {
  margin-right: 14rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #76808f;
  font-size: 24rpx;
}

.sort-active {
  background: #10161f;
  color: #fff8e9;
  font-weight: 800;
}

.article-list {
  margin-top: 30rpx;
}

.article-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 40rpx rgba(31, 43, 58, 0.08);
}

.article-cover {
  flex: 0 0 156rpx;
  width: 156rpx;
  height: 156rpx;
  border-radius: 22rpx;
  background: #202b38;
}

.placeholder-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f2c66d;
  font-size: 52rpx;
  font-weight: 900;
}

.article-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 4rpx 4rpx 22rpx;
}

.article-title {
  color: #18212c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.article-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #67717e;
  font-size: 24rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-row {
  margin-top: 12rpx;
}

.tag {
  display: inline-block;
  margin: 0 8rpx 8rpx 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #fff6dd;
  color: #8a5f1d;
  font-size: 20rpx;
}

.article-meta {
  margin-top: 16rpx;
  color: #b07a22;
  font-size: 22rpx;
}

.dedicated-card {
  margin: 24rpx 0;
  padding: 32rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(135deg, #2a1a3f 0%, #4a2f74 100%);
  color: #fff8e9;
  box-shadow: 0 18rpx 44rpx rgba(42, 26, 63, 0.4);
}

.dedicated-eyebrow {
  color: #c8a8ff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.dedicated-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.dedicated-desc {
  margin-top: 12rpx;
  color: rgba(255, 248, 233, 0.78);
  font-size: 26rpx;
  line-height: 1.5;
}

.dedicated-cta {
  margin-top: 20rpx;
  display: inline-block;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 233, 0.16);
  color: #fff8e9;
  font-size: 26rpx;
  font-weight: 700;
}
