.home-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 0;
  background: transparent;
}

.hero {
  padding: 24rpx 4rpx 36rpx;
  color: #fff8e9;
}

.eyebrow {
  display: inline-block;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 248, 233, 0.24);
  border-radius: 999rpx;
  color: #f2c66d;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255, 248, 233, 0.74);
  font-size: 28rpx;
  line-height: 1.6;
}

.search-card {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 60rpx rgba(16, 22, 31, 0.16);
}

.search-icon {
  margin-right: 16rpx;
  color: #b07a22;
  font-size: 34rpx;
}

.search-placeholder {
  color: #7a8491;
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #18212c;
  font-size: 26rpx;
}

.search-action {
  margin-left: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #10161f;
  color: #fff8e9;
  font-size: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 34rpx 4rpx 18rpx;
}

.section-title {
  color: #fff8e9;
  font-size: 32rpx;
  font-weight: 900;
}

.section-note {
  color: rgba(255, 248, 233, 0.72);
  font-size: 22rpx;
}

.library-head {
  align-items: center;
  margin-top: 30rpx;
}

.toggle-games {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #10161f;
  color: #fff8e9;
  font-size: 22rpx;
}

.game-list {
  display: block;
}

.game-tile {
  display: block;
  width: auto;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(242, 198, 109, 0.22), transparent 32%),
    rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 42rpx rgba(31, 43, 58, 0.1);
}

.game-main {
  display: flex;
  align-items: center;
  min-height: 150rpx;
}

.tile-mark {
  display: flex;
  flex: 0 0 96rpx;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 900;
}

.tile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.tile-name {
  overflow: hidden;
  color: #18212c;
  font-size: 40rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #76808f;
  font-size: 26rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.game-arrow {
  margin-left: 20rpx;
  color: #b7a27f;
  font-size: 66rpx;
  font-weight: 300;
}

.version-footer {
  padding: 42rpx 0 36rpx;
  text-align: center;
  color: rgba(24, 33, 44, 0.38);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.ad-safe-space {
  height: 156rpx;
}

.banner-ad-wrap {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(245, 242, 234, 0.94);
}
