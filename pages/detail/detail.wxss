.detail-page {
  padding-bottom: 148rpx;
  background: transparent;
}

.article-head {
  padding: 18rpx 4rpx 32rpx;
}

.game-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #10161f;
  color: #f2c66d;
  font-size: 22rpx;
}

.article-title {
  margin-top: 24rpx;
  color: #18212c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.22;
}

.article-meta {
  margin-top: 18rpx;
  color: #8a6b39;
  font-size: 24rpx;
}

.article-summary {
  margin-top: 22rpx;
  color: #5f6a76;
  font-size: 28rpx;
  line-height: 1.6;
}

.tag-row {
  margin-top: 18rpx;
}

.tag {
  display: inline-block;
  margin: 0 10rpx 10rpx 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #fff6dd;
  color: #8a5f1d;
  font-size: 22rpx;
}

.stat-row {
  display: flex;
  margin-top: 14rpx;
  color: #76808f;
  font-size: 22rpx;
}

.stat-row view {
  margin-right: 24rpx;
}

.action-row {
  display: flex;
  margin-bottom: 24rpx;
}

.action-button,
.share-button {
  flex: 1;
  margin-right: 14rpx;
  padding: 18rpx 0;
  border: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #18212c;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.share-button::after {
  border: 0;
}

.action-button:last-child {
  margin-right: 0;
}

.action-active {
  background: #10161f;
  color: #fff8e9;
}

.hero-image {
  width: 100%;
  height: 360rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #202b38;
  box-shadow: 0 20rpx 48rpx rgba(31, 43, 58, 0.16);
}

.content-card {
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 42rpx rgba(31, 43, 58, 0.08);
}

.rich-content {
  color: #27313d;
  font-size: 30rpx;
  line-height: 1.78;
}

.image-section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #18212c;
  font-size: 30rpx;
  font-weight: 800;
}

.guide-image {
  width: 100%;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 32rpx rgba(31, 43, 58, 0.08);
}

.related-section {
  margin-top: 30rpx;
}

.related-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
}

.related-title {
  color: #18212c;
  font-size: 28rpx;
  font-weight: 800;
}

.related-meta {
  margin-top: 10rpx;
  color: #8a6b39;
  font-size: 22rpx;
}

.back-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  border-radius: 999rpx;
  background: #10161f;
  color: #fff8e9;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 18rpx 44rpx rgba(16, 22, 31, 0.22);
}

.back-button::after {
  border: 0;
}
