.rk-page {
  background:
    linear-gradient(180deg, #2a1a3f 0%, #3b2960 280rpx, transparent 280rpx),
    #f5f2ea;
}

.rk-head {
  color: #fff8e9;
}

.eyebrow {
  color: #c8a8ff;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.muted-line {
  margin-top: 8rpx;
  color: rgba(255, 248, 233, 0.7);
  font-size: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 18rpx 48rpx rgba(16, 22, 31, 0.18);
}

.search-input {
  flex: 1;
  color: #18212c;
  font-size: 28rpx;
}

.search-button {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #2a1a3f;
  color: #fff8e9;
  font-size: 24rpx;
}

.pill-row {
  display: flex;
  white-space: nowrap;
  margin-top: 28rpx;
  padding: 4rpx 0;
}

.pill {
  display: inline-block;
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #2a1a3f;
  font-size: 24rpx;
}

.pill-active {
  background: #2a1a3f;
  color: #fff8e9;
}

.sort-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.sort-pill {
  margin-right: 12rpx;
  padding: 8rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(42, 26, 63, 0.4);
  color: #2a1a3f;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.6);
}

.sort-active {
  background: #2a1a3f;
  border-color: #2a1a3f;
  color: #fff8e9;
}

.sort-count {
  margin-left: auto;
  color: #66717f;
  font-size: 22rpx;
}

.pet-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 28rpx;
}

.pet-card {
  padding: 24rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 14rpx 36rpx rgba(31, 43, 58, 0.08);
}

.pet-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f3ebff 0%, #e9def8 100%);
}

.pet-avatar {
  width: 140rpx;
  height: 140rpx;
}

.pet-avatar-fallback {
  font-size: 64rpx;
  font-weight: 900;
  color: #6f66d8;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #18212c;
}

.pet-id {
  margin-top: 4rpx;
  color: #b07a22;
  font-size: 22rpx;
}

.type-row {
  margin-top: 12rpx;
}

.type-pill {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(42, 26, 63, 0.1);
  color: #2a1a3f;
  font-size: 22rpx;
}

.stat-row {
  display: flex;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(24, 33, 44, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.stat-label {
  color: #76808f;
  margin-right: 6rpx;
}

.stat-value {
  color: #18212c;
  font-weight: 700;
}

.finished-line {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
}
