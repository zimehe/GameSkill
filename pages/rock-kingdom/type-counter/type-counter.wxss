.rk-page {
  background:
    linear-gradient(180deg, #4a2418 0%, #6a3220 280rpx, transparent 280rpx),
    #f5f2ea;
}

.rk-head {
  color: #fff8e9;
}

.eyebrow {
  color: #f3b08f;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.muted-line {
  margin-top: 8rpx;
  color: rgba(255, 248, 233, 0.7);
  font-size: 24rpx;
}

.matrix-wrap {
  margin-top: 30rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 14rpx 36rpx rgba(31, 43, 58, 0.1);
  white-space: nowrap;
}

.matrix-inner {
  display: inline-block;
}

.matrix-row {
  display: flex;
}

.matrix-header .header-cell,
.matrix-row .matrix-cell,
.matrix-row .row-head,
.corner-cell {
  width: 90rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border-right: 1rpx solid rgba(74, 36, 24, 0.1);
  border-bottom: 1rpx solid rgba(74, 36, 24, 0.1);
}

.corner-cell {
  background: rgba(74, 36, 24, 0.06);
  color: #4a2418;
  font-weight: 700;
}

.header-cell {
  background: rgba(74, 36, 24, 0.06);
  color: #4a2418;
  font-weight: 600;
}

.row-head {
  background: rgba(74, 36, 24, 0.06);
  color: #4a2418;
  font-weight: 600;
}

.matrix-cell {
  color: #18212c;
}

.cell-strong {
  background: #ffe0a8;
  color: #b03d00;
  font-weight: 700;
}

.cell-weak {
  background: #d8eef6;
  color: #21607c;
  font-weight: 700;
}

.cell-neutral {
  background: #fff;
  color: #76808f;
}

.row-highlight .row-head {
  background: #4a2418;
  color: #fff8e9;
}

.row-highlight .matrix-cell {
  box-shadow: inset 0 -3rpx 0 rgba(74, 36, 24, 0.5);
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #4a2418;
  font-size: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 28rpx;
  margin-bottom: 10rpx;
}

.legend-swatch {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
}
