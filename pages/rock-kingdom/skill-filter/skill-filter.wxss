.rk-page {
  background: transparent;
}

.rk-head {
  color: #fff8e9;
}

.eyebrow {
  color: #b3e9c4;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.muted-line {
  margin-top: 8rpx;
  color: rgba(255, 248, 233, 0.7);
  font-size: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 18rpx 48rpx rgba(16, 22, 31, 0.18);
}

.search-input {
  flex: 1;
  color: #18212c;
  font-size: 28rpx;
}

.search-button {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #1a4733;
  color: #fff8e9;
  font-size: 24rpx;
}

.section-title {
  margin: 32rpx 0 16rpx;
  color: #18212c;
  font-size: 26rpx;
  font-weight: 700;
}

.move-list {
  margin-top: 8rpx;
}

.move-item {
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 30rpx rgba(31, 43, 58, 0.06);
}

.move-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #18212c;
}

.move-meta {
  margin-top: 6rpx;
  color: #66717f;
  font-size: 22rpx;
}

.selected-card {
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 14rpx 36rpx rgba(31, 43, 58, 0.1);
}

.selected-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #18212c;
}

.selected-meta {
  margin-top: 8rpx;
  color: #b07a22;
  font-size: 22rpx;
}

.selected-desc {
  margin-top: 12rpx;
  color: #66717f;
  font-size: 24rpx;
  line-height: 1.5;
}

.pet-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.pet-card {
  padding: 20rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 28rpx rgba(31, 43, 58, 0.06);
  text-align: center;
}

.pet-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 130rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e5f8ec 0%, #cdf0d8 100%);
}

.pet-avatar {
  width: 110rpx;
  height: 110rpx;
}

.pet-avatar-fallback {
  font-size: 56rpx;
  font-weight: 900;
  color: #1a4733;
}

.pet-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #18212c;
}

.pet-id {
  margin-top: 4rpx;
  color: #b07a22;
  font-size: 20rpx;
}
