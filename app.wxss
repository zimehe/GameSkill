page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 0%, rgba(242, 198, 109, 0.28), transparent 30%),
    radial-gradient(circle at 88% 18%, rgba(111, 102, 216, 0.18), transparent 34%),
    linear-gradient(160deg, #10161f 0%, #1d2c40 34%, #efe4cf 72%, #f8f1df 100%);
  color: #18212c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  padding: 40rpx 32rpx;
}

.muted {
  color: #76808f;
}

.empty-state,
.loading-state {
  margin-top: 40rpx;
  padding: 40rpx 28rpx;
  border: 1rpx solid rgba(24, 33, 44, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #76808f;
  text-align: center;
}
